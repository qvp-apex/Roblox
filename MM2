local url = "https://gist.githubusercontent.com/qvp-apex/d3b0f75d1587fc9bffe18cbf8600523c/raw/f5538670bd5a95b0fa51a2247a4dd0d402cb5731/gistfile1.txt"

-- Fungsi untuk mengambil konten dari URL
local function fetchScript(url)
    local success, result = pcall(function()
        return game:HttpGet(url)
    end)
    
    if success and result then
        return result
    else
        warn("Gagal mengambil script: " .. tostring(result))
        return nil
    end
end

-- Ambil script
local scriptContent = fetchScript(url)

if scriptContent then
    -- Jalankan script yang diambil
    local loadSuccess, loadError = pcall(function()
        loadstring(scriptContent)()
    end)
    
    if not loadSuccess then
        warn("Gagal menjalankan script: " .. tostring(loadError))
    end
else
    warn("Script tidak ditemukan atau gagal diambil.")
end
